{
  "manifest_version": 3,
  "name": "DirectImageSaver",
  "version": "0.1.0",
  "description": "Save hovered images and direct-link videos through a Windows native host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "directimagesaver@rare2rare",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "vendor/browser-polyfill.min.js",
      "service-worker.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/browser-polyfill.min.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DirectImageSaver",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
