<Window x:Class="DirectImageSaver.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DirectImageSaver 設定"
        Width="520"
        Height="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="保存先フォルダ" />
        <TextBox x:Name="SaveDirectoryTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="0,0,8,12"
                 VerticalContentAlignment="Center" />
        <Button Grid.Row="0"
                Grid.Column="2"
                Width="72"
                Margin="0,0,0,12"
                Click="BrowseButton_OnClick"
                Content="参照" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="保存トリガー" />
        <ComboBox x:Name="TriggerModeComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12" />

        <CheckBox x:Name="SuccessSoundCheckBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,8"
                  Content="成功時に音を鳴らす" />
        <CheckBox x:Name="ErrorSoundCheckBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,8"
                  Content="失敗時に音を鳴らす" />
        <CheckBox x:Name="AutoStartCheckBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,12"
                  VerticalAlignment="Top"
                  Content="Windows サインイン時に DirectImageSaver を常駐起動する" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="88"
                    Margin="0,0,8,0"
                    Click="SaveButton_OnClick"
                    Content="保存" />
            <Button Width="88"
                    IsCancel="True"
                    Content="キャンセル" />
        </StackPanel>
    </Grid>
</Window>
